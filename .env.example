# Auto Fans Scraper — 环境变量示例
# 复制此文件为 .env 并按需修改。
# 未设置的项将使用 config.py 中的默认值。

# ── 搜索参数 ──────────────────────────────────────────────
MIN_AGE=53
MAX_AGE=75
ONLY_WIRELESS=true          # true / false

# ── 浏览器配置 ────────────────────────────────────────────
HEADLESS=false              # true = 无界面运行（服务器场景）
TIMEOUT=30000               # 页面加载超时，毫秒
WAIT_TIME=2                 # 页面就绪后额外等待，秒

# ── 重试配置 ──────────────────────────────────────────────
MAX_RETRIES=3               # 网络/页面动作最大重试次数
RETRY_BASE_DELAY=1.0        # 指数退避起始延迟，秒

# ── Cloudflare 处理策略 ───────────────────────────────────
# manual : 记录日志，等待有限时间后继续（不阻塞 STDIN）
# skip   : 直接跳过该条记录（默认，推荐无人值守场景）
# retry  : 按 MAX_RETRIES 次重试后放弃
CF_MODE=skip

# ── 日志 ──────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG / INFO / WARNING / ERROR
LOG_FILE=logs/app.log

# ── 输入输出 ──────────────────────────────────────────────
INPUT_FILE=data/names.txt
OUTPUT_FILE=data/results.csv
